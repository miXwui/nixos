{
  "layer": "top", // Waybar at top layer
  "position": "bottom", // Waybar position (top|bottom|left|right)
  "height": 30, // Waybar height (to be removed for auto height)
  // "width": 1280, // Waybar width
  // Choose the order of the modules
  "modules-left": [
    "sway/workspaces",
    "sway/mode",
    "sway/scratchpad",
    "custom/media",
    "cpu",
    "temperature",
    "memory",
    "disk",
    "battery",
    "network",
    "bluetooth",
    // "mpv",
    "privacy"
  ],
  "modules-center": ["sway/window"],
  "modules-right": [
    "idle_inhibitor",
    "custom/dunst",
    "custom/power_profile",
    // "pulseaudio#sink",
    // "pulseaudio#source",
    "wireplumber",
    // TODO:
    // Finish wireplumber implementation when the module for source
    // releases and the sink/source module has port name support
    // e.g. headphone, headset, car.
    // https://github.com/Alexays/Waybar/pull/1905
    // https://github.com/Alexays/Waybar/issues/3229
    "custom/wireplumber-source",
    "backlight",
    "custom/weather",
    "clock",
    "tray"
  ],
  // Modules configuration
  // "sway/workspaces": {
  //     "disable-scroll": true,
  //     "all-outputs": true,
  //     "format": "{name}: {icon}",
  //     "format-icons": {
  //         "1": "",
  //         "2": "",
  //         "3": "",
  //         "4": "",
  //         "5": "",
  //         "urgent": "",
  //         "focused": "",
  //         "default": ""
  //     }
  // },
  "sway/mode": {
    "format": "<span style=\"italic\">{}</span>",
    "min-length": 10
  },
  "sway/scratchpad": {
    "format": "{icon} {count}",
    "show-empty": false,
    "format-icons": ["", ""],
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  },
  "mpd": {
    "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ {volume}% ",
    "format-disconnected": "Disconnected ",
    "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
    "unknown-tag": "N/A",
    "interval": 60,
    "consume-icons": {
      "on": " "
    },
    "random-icons": {
      "off": "<span color=\"#f53c3c\"></span> ",
      "on": " "
    },
    "repeat-icons": {
      "on": " "
    },
    "single-icons": {
      "on": "1 "
    },
    "state-icons": {
      "paused": "",
      "playing": ""
    },
    "tooltip-format": "MPD (connected)",
    "tooltip-format-disconnected": "MPD (disconnected)"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    // `timeout` is in minutes. Possible to set partial minutes like so: `30.5`.
    "timeout": 30.5
  },
  "custom/dunst": {
    // Waiting on this to be able to pass in JSON keys, e.g.:
    // "format": "{count}{icon}"
    // https://github.com/Alexays/Waybar/issues/432
    "format": "{}{icon}",
    "format-icons": {
      "unmuted": "",
      "muted": ""
    },
    "return-type": "json",
    "tooltip": true,
    "exec": "~/.config/waybar/scripts/dunst.sh",
    "on-click": "dunstctl set-paused toggle",
    "restart-interval": 60
  },
  "tray": {
    // "icon-size": 21,
    "spacing": 10
  },
  "clock": {
    // "timezone": "America/New_York",
    "format": "{:%a %m-%d %I:%M %p}",
    "format-alt": "{:%a %m-%d-%Y %I:%M:%S %p}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
                "mode"          : "year",
                "mode-mon-col"  : 3,
                "weeks-pos"     : "right",
                "on-scroll"     : 1,
                "format": {
                          "months":     "<span color='#ffead3'><b>{}</b></span>",
                          "days":       "<span color='#ecc6d9'><b>{}</b></span>",
                          "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
                          "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
                          "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
                          }
                },
    "interval": 60,
    "on-click-right": "gnome-calendar"
  },
  "cpu": {
    "format": "{usage}% {avg_frequency} ",
    "tooltip": false,
    // default is 10
    "interval": 60
  },
  "temperature": {
    // "thermal-zone": 2,
    // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "critical-threshold": 80,
    // "format-critical": "{temperatureC}°C {icon}",
    "format": "{temperatureC}°C {icon}",
    "format-icons": ["", "", ""],
    "interval": 60
  },
  "memory": {
    "format": "{}% "
  },
  "disk": {
    "interval": 60,
    "format": "{free} {path}",
    "path": "/"
  },
  "backlight": {
    // "device": "acpi_video1",
    "format": "{percent}% {icon}",
    "format-icons": ["🌚", "🌛", "🌓", "🌔", "🌝"],
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "on-click": "brightnessctl set 30%",
    "on-click-right": "brightnessctl set 75%",
    "on-click-middle": "brightnessctl set 100%"
  },
  "battery": {
    "states": {
      // "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon} {power:.3}W",
    "format-charging": "{capacity}%  {power:.3}W",
    "format-plugged": "{capacity}%  {power:.3}W",
    "format-alt": "{time} {icon} {power:.3}W",
    // "format-good": "", // An empty format will hide the module
    // "format-full": "",
    "format-icons": ["", "", "", "", ""],
    // "max-length": 25,
    "interval": 60
  },
  "battery#bat2": {
    "bat": "BAT2"
  },
  "bluetooth": {
    //"format": "{icon} {status}",
    "interval": 60,
    "format-icons": {
      "enabled": " on",
      "disabled": " off"
    },
    "tooltip-format": "{status}",
    "on-click-right": "blueman-manager"
  },
  "privacy": {
    "icon-spacing": 4,
    "icon-size": 18,
    "transition-duration": 250,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 24
      },
      {
        "type": "audio-out",
        "tooltip": true,
        "tooltip-icon-size": 24
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 24
      }
    ]
  },
  "network": {
    // "interface": "wlp2*", // (Optional) To force the use of this interface
    "format-wifi": "{essid} ({signalStrength}%) ",
    "format-ethernet": "{ifname}: {ipaddr}/{cidr} ",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "Disconnected ⚠",
    "format-alt": "down: {bandwidthDownBits} up: {bandwidthUpBits}",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    "interval": 60
  },
  // "pulseaudio#sink": {
  //   // "scroll-step": 1, // %, can be a float
  //   "format": "{volume}% {icon}",
  //   "format-muted": "",
  //   "format-bluetooth": "{volume}% {icon} {desc}",
  //   "format-bluetooth-muted": " {icon} {desc}",
  //   "format-icons": {
  //     "hifi": "hifi",
  //     "headphone": "",
  //     "hands-free": "",
  //     "headset": "",
  //     "phone": "",
  //     "portable": "",
  //     "car": "",
  //     "default": ["", "", ""]
  //   },
  //   "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
  //   "on-click-right": "gnome-control-center sound"
  // },
  // "pulseaudio#source": {
  //   "format": "{format_source}",
  //   "format-source": "{volume}% ",
  //   "format-source-muted": "",
  //   "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
  //   "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 1%+",
  //   "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 1%-",
  //   "on-click-right": "gnome-control-center sound",
  //   "tooltip": false
  // },
  "wireplumber": {
    "format": "{volume}% {icon}",
    "format-muted": "{volume}%🔇",
    "max-volume": 200.0,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol -t 3",
    "on-click-middle": "crosspipe",
    "format-icons": ["", "", ""]
  },
  "custom/wireplumber-source": {
    "format": "{}% {icon}",
    "format-icons": {
      "unmuted": "",
      "muted": ""
    },
    "return-type": "json",
    "exec": "$HOME/.config/waybar/scripts/wireplumber-source.sh",
    "exec-on-event": true,
    "interval": "once",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 1%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 1%-",
    "on-click-right": "pavucontrol -t 4",
    "on-click-middle": "crosspipe"
  },
  "custom/media": {
    "format": "{icon} {}",
    "return-type": "json",
    "max-length": 40,
    "format-icons": {
      "spotify": "",
      "default": "🎜"
    },
    "escape": true,
    "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null" // Script in resources folder
    // "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null" // Filter player based on name
  },
  "custom/weather": {
    "format": "{}",
    "return-type": "json",
    "tooltip": true,
    "interval": 900,
    "exec": "$HOME/.config/waybar/scripts/weather.sh",
    "on-click": "$HOME/.config/waybar/scripts/weather.sh'"
  },
  "custom/power_profile": {
    "return-type": "json",
    "tooltip": true,
    "exec": "~/.config/waybar/scripts/power_profile.sh",
    "interval": 60,
    "on-click": "",
    "on-click-right": "pkexec ~/.config/waybar/scripts/set-battery-profile.sh",
    "on-click-middle": "pkexec ~/.config/waybar/scripts/set-ac-profile.sh"
  }
}
